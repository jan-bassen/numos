{
  "name": "core",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "core": "bin/core.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "esbuild src/functions/*.ts --bundle --minify --sourcemap --platform=node --target=es2022 --outbase=src --entry-names=[name] --outdir=dist/functions",
    "test": "jest",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy --require-approval never",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:typegen": "supabase gen types typescript --project-id izjqprmqnuotxzejbgxs > src/types/database.types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.696.0",
    "@aws-sdk/lib-dynamodb": "^3.698.0",
    "@repo/shared": "workspace:*",
    "@repo/engine": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/aws-lambda": "^8.10.145",
    "aws-cdk-lib": "2.156.0",
    "constructs": "^10.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4",
    "sdk": "^0.5.0",
    "source-map-support": "^0.5.21",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.9",
    "aws-cdk": "2.156.0",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.24.2",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  }
}
