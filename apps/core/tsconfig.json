{
  "extends": "@repo/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": false,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "src",
    "test"  ],
  "exclude": [
    "dist",
    "cdk.out",
    "drizzle.config.ts",
    "jest.config.ts"
  ]
}