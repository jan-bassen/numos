{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --diagnostics",
    "typecheck:clean": "tsc --build --clean",
    "lint": "biome lint",
    "scan": "next dev --turbopack & npx react-scan@latest localhost:3000",
    "auth:generate": "npx @better-auth/cli generate --output ./db/schemas/auth.ts --config ./server/auth/index.ts --y",
    "db:generate": "npx @better-auth/cli generate --output ./db/schemas/auth.ts --config ./server/auth/index.ts --y && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "  npx @better-auth/cli generate --output ./db/schemas/auth.ts --config ./server/auth/index.ts --y && drizzle-kit push"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@biomejs/biome": "^2.0.0",
    "@bonfida/spl-name-service": "^3.0.10",
    "@daveyplate/better-auth-ui": "^1.2.19",
    "@delegatexyz/sdk": "^0.6.0",
    "@hookform/resolvers": "3.10.0",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "@solana/web3.js": "^1.98.0",
    "alchemy-sdk": "^3.5.3",
    "better-auth": "^1.2.3",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.40.1",
    "drizzle-zod": "0.7.0",
    "next": "15.1.11",
    "next-themes": "^0.4.4",
    "opensea-js": "^7.1.18",
    "postgres": "^3.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "viem": "^2.21.45",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.0.9",
    "@types/node": "^20.17.16",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.30.5",
    "postcss": "^8.4.27",
    "react-scan": "0.0.54",
    "tailwindcss": "4.0.9",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  }
}
